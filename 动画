describe('待机圆球轻微呼吸。一拍和两拍为圆球上下弹动，三拍以上为圆角多边形。拍点只突出当前拍，无阴影。');
}
function draw() {
const dark = window\.matchMedia('(prefers-color-scheme: dark)').matches;
const ink = dark ? 242 : 20, muted = dark ? 105 : 175;
