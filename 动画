const idle = state === 'idle';
const breathing = idle && !reduced.matches ? 1 + 0.035 \* Math.sin(millis() / 1000 \* TWO\_PI / 3.5) : 1;
const angle = idle || n <= 2 || reduced.matches ? 0 : (Math.floor(beat) + ease) \* TWO\_PI / n;
const offset = idle || reduced.matches ? 0 : Math.sin(PI \* t) \* (n <= 2 ? size \* 0.1 + amplitude : -amplitude);
const target = contour(idle ? 1 : n).map(p => ({
x: (p.x \* Math.cos(angle) - p.y \* Math.sin(angle)) \* size \* breathing,
y: (p.x \* Math.sin(angle) + p.y \* Math.cos(angle)) \* size \* breathing + offset
