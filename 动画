if (state === 'playing') beat += Math.min(deltaTime, 80) / 60000 \* Number(tempo.value());
const n = Number(meter.value()), phase = beat % 1, current = Math.floor(beat) % n;
const size = Math.min(74, width \* 0.2), y = height / 2;
const speed = constrain((Number(tempo.value()) - 100) / 60, 0, 1);
const speedMix = speed \* speed \* (3 - 2 \* speed);
